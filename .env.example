# Copy to .env. Never commit .env.
DJANGO_SETTINGS_MODULE=core.settings.development
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Product identity and locale
DJANGO_SITE_NAME=تابلو دات کام
DJANGO_LANGUAGE_CODE=fa
DJANGO_LANGUAGES=
DJANGO_TEXT_DIRECTION=rtl
DJANGO_TIME_ZONE=Asia/Tehran

# Data — set real credentials in .env (never commit secrets)
POSTGRES_DB=tablo_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5432/tablo_db
DJANGO_DB_CONN_MAX_AGE=60
REDIS_URL=

# OTP / SMS
OTP_TTL_MINUTES=5
OTP_SEND_LIMIT=5
OTP_VERIFY_LIMIT=10
SMS_PROVIDER=apps.accounts.sms.ConsoleSmsProvider
ANALYTICS_PROVIDER=apps.analytics.services.ConsoleAnalyticsProvider

# Email — development defaults to the console backend.
DJANGO_EMAIL_BACKEND=
DJANGO_DEFAULT_FROM_EMAIL=noreply@tablo.com
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=25
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=false

# API throttling (DRF)
DJANGO_THROTTLE_ANON=60/min
DJANGO_THROTTLE_USER=600/min
DJANGO_THROTTLE_OTP=10/min

# Uploads
IMAGE_UPLOAD_MAX_BYTES=5242880

# Logging
DJANGO_LOG_LEVEL=INFO
DJANGO_APP_LOG_LEVEL=INFO
DJANGO_LOG_SQL=false

# Production only
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_ADMIN_EMAILS=
